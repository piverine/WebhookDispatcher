# HTTP Port
PORT=3000

# PostgreSQL connection string (Neon or Supabase format: postgresql://user:pass@ep-xyz.region.aws.neon.tech/neondb?sslmode=require)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Worker Configuration
WORKER_CONCURRENCY=5
POLL_INTERVAL_MS=500
DELIVERY_TIMEOUT_MS=5000
MAX_ATTEMPTS=4
BACKOFF_BASE_MS=2000

# Rate Limiting
RATE_BUCKET_CAPACITY=5
RATE_REFILL_PER_SEC=2
INGEST_RATE_LIMIT_PER_MIN=100

# Safety & Destination Security
ALLOW_PRIVATE_DESTINATIONS=false

# Optional HMAC Signing Secret (X-Webhook-Signature)
WEBHOOK_SIGNING_SECRET=

