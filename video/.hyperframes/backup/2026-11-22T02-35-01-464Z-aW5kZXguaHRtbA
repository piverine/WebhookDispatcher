<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=1920, height=1080">
    <title>Webhook Dispatcher — Hackathon Demo</title>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/gsap.min.js"></script>
    <style>
      :root {
        --bg: #060911;
        --surface: #0c1322;
        --accent: #38bdf8;
        --green: #34d399;
        --red: #f87171;
        --amber: #fbbf24;
        --pink: #f472b6;
        --mono: "JetBrains Mono", monospace;
        --sans: "Outfit", sans-serif;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body {
        width: 1920px; height: 1080px; overflow: hidden;
        background: var(--bg); color: #f1f5f9;
        font-family: var(--sans);
      }

      /* ── Full-frame stage ── */
      #root {
        position: relative; width: 1920px; height: 1080px;
        background: radial-gradient(ellipse 120% 90% at 50% 20%, #111b30 0%, #060911 70%);
      }

      /* ── Kinetic hero lines ── */
      .kline {
        position: absolute; left: 0; width: 1920px;
        display: flex; align-items: center; justify-content: center;
        font-weight: 800; letter-spacing: -0.03em;
        white-space: nowrap;
      }
      #k1 { top: 240px; font-size: 92px; color: #fff; }
      #k2 { top: 350px; font-size: 44px; color: var(--accent); font-weight: 600; letter-spacing: 0.04em; }

      /* ── Feature blast words ── */
      .feat-word {
        position: absolute;
        font-family: var(--mono);
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }
      #fw1 { top: 180px; left: 140px; font-size: 56px; color: var(--green); }
      #fw2 { top: 310px; left: 1080px; font-size: 48px; color: var(--accent); }
      #fw3 { top: 440px; left: 260px; font-size: 52px; color: var(--pink); }
      #fw4 { top: 560px; left: 900px; font-size: 46px; color: var(--amber); }
      #fw5 { top: 680px; left: 180px; font-size: 44px; color: var(--red); }
      #fw6 { top: 790px; left: 760px; font-size: 50px; color: var(--green); }

      /* ── Architecture flow diagram ── */
      #arch-stage {
        position: absolute; top: 0; left: 0; width: 1920px; height: 1080px;
        display: flex; align-items: center; justify-content: center;
      }
      .arch-node {
        position: absolute;
        background: var(--surface);
        border: 2px solid #1e293b;
        border-radius: 10px;
        padding: 16px 28px;
        font-family: var(--mono);
        font-size: 18px;
        font-weight: 700;
        text-align: center;
        line-height: 1.3;
      }
      .arch-arrow {
        position: absolute;
        height: 3px;
        background: var(--accent);
        transform-origin: left center;
      }
      .arch-arrow-v {
        position: absolute;
        width: 3px;
        background: var(--accent);
        transform-origin: top center;
      }
      #an-client  { top: 100px; left: 780px; border-color: var(--accent); color: var(--accent); }
      #an-fastify { top: 240px; left: 680px; border-color: #818cf8; color: #c4b5fd; width: 520px; }
      #an-pg      { top: 420px; left: 720px; border-color: var(--green); color: var(--green); width: 440px; }
      #an-worker  { top: 600px; left: 660px; border-color: var(--amber); color: var(--amber); width: 560px; }
      #an-dest    { top: 780px; left: 780px; border-color: var(--pink); color: var(--pink); }

      /* ── Tech stack tower ── */
      .stack-row {
        position: absolute; left: 50%; transform: translateX(-50%);
        display: flex; align-items: center; gap: 24px;
        font-family: var(--mono); font-weight: 700;
      }
      .stack-tag {
        font-size: 15px; padding: 10px 24px;
        border-radius: 8px; border: 2px solid;
        background: var(--surface);
      }
      #sr1 { top: 160px; }
      #sr2 { top: 260px; }
      #sr3 { top: 360px; }
      #sr4 { top: 460px; }
      #sr5 { top: 560px; }
      #sr6 { top: 660px; }
      #sr7 { top: 760px; }

      /* ── Stat slam counters ── */
      .stat-slam {
        position: absolute;
        text-align: center;
        font-family: var(--mono);
      }
      .stat-num {
        font-size: 90px; font-weight: 900;
        line-height: 1;
      }
      .stat-lbl {
        font-size: 22px; font-weight: 600;
        color: #94a3b8; text-transform: uppercase;
        letter-spacing: 0.06em; margin-top: 8px;
      }
      #st1 { top: 300px; left: 200px; }
      #st2 { top: 300px; left: 760px; }
      #st3 { top: 300px; left: 1320px; }

      /* ── End card ── */
      #endcard {
        position: absolute; inset: 0;
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        text-align: center;
      }
      #end-title {
        font-size: 58px; font-weight: 800;
        letter-spacing: -0.02em; color: #fff;
        margin-bottom: 16px;
      }
      #end-tagline {
        font-size: 28px; font-weight: 500;
        color: var(--accent);
        letter-spacing: 0.02em;
        margin-bottom: 32px;
      }
      #end-url {
        font-family: var(--mono);
        font-size: 20px; color: #94a3b8;
        background: var(--surface);
        border: 1px solid #1e293b;
        padding: 12px 32px;
        border-radius: 9999px;
      }

      /* Utility */
      .hidden { opacity: 0; }
    </style>
  </head>
  <body>
    <div data-hf-id="hf-j7pz" id="root" data-composition-id="main" data-start="0" data-duration="30" data-width="1920" data-height="1080">

      <!-- ═══ BEAT 1: Hero title slam (0–3s) ═══ -->
      <div data-hf-id="hf-t8lj" id="k1" class="kline clip hidden" data-start="0" data-duration="3.5" data-track-index="0">Webhook Dispatcher Engine</div>
      <div data-hf-id="hf-nxdg" id="k2" class="kline clip hidden" data-start="0.3" data-duration="3.2" data-track-index="0">Distributed · Resilient · Asynchronous</div>

      <!-- ═══ BEAT 2: Feature blast (3–8s) ═══ -->
      <div data-hf-id="hf-cdbf" id="fw1" class="feat-word clip hidden" data-start="3" data-duration="5.5" data-track-index="1">Non-blocking 202 Accepted</div>
      <div data-hf-id="hf-aazu" id="fw2" class="feat-word clip hidden" data-start="3" data-duration="5.5" data-track-index="1">PostgreSQL Durable Queue</div>
      <div data-hf-id="hf-4crr" id="fw3" class="feat-word clip hidden" data-start="3" data-duration="5.5" data-track-index="1">Redis Lua Token Bucket</div>
      <div data-hf-id="hf-xdot" id="fw4" class="feat-word clip hidden" data-start="3" data-duration="5.5" data-track-index="1">Circuit Breaker Engine</div>
      <div data-hf-id="hf-bduz" id="fw5" class="feat-word clip hidden" data-start="3" data-duration="5.5" data-track-index="1">Exponential Backoff + Jitter</div>
      <div data-hf-id="hf-1uj1" id="fw6" class="feat-word clip hidden" data-start="3" data-duration="5.5" data-track-index="1">Dead-Letter Queue Redrive</div>

      <!-- ═══ BEAT 3: Architecture assembles (8–16s) ═══ -->
      <div data-hf-id="hf-spp8" id="arch-stage" class="clip hidden" data-start="8" data-duration="8.5" data-track-index="2">
        <div data-hf-id="hf-8gi7" id="an-client" class="arch-node">Producer Client</div>
        <div data-hf-id="hf-42bo" id="aa1" class="arch-arrow-v" style="top:150px; left:920px; height:90px;"></div>
        <div data-hf-id="hf-e20l" id="an-fastify" class="arch-node">Fastify 5 API → Zod Validate → INSERT ON CONFLICT → 202</div>
        <div data-hf-id="hf-aa1y" id="aa2" class="arch-arrow-v" style="top:300px; left:920px; height:120px;"></div>
        <div data-hf-id="hf-96t0" id="an-pg" class="arch-node">PostgreSQL 16 — FOR UPDATE SKIP LOCKED</div>
        <div data-hf-id="hf-mul8" id="aa3" class="arch-arrow-v" style="top:480px; left:920px; height:120px;"></div>
        <div data-hf-id="hf-rirr" id="an-worker" class="arch-node">Worker Pool → Rate Limit → Circuit Break → Deliver</div>
        <div data-hf-id="hf-4pga" id="aa4" class="arch-arrow-v" style="top:665px; left:920px; height:115px;"></div>
        <div data-hf-id="hf-es7c" id="an-dest" class="arch-node">Destination Server</div>
      </div>

      <!-- ═══ BEAT 4: Stats slam in (16–20s) ═══ -->
      <div data-hf-id="hf-s11h" id="st1" class="stat-slam clip hidden" data-start="16" data-duration="4.5" data-track-index="3">
        <div data-hf-id="hf-hk14" class="stat-num" style="color: var(--green);">&lt;15ms</div>
        <div data-hf-id="hf-96n5" class="stat-lbl">Ingestion Latency</div>
      </div>
      <div data-hf-id="hf-014m" id="st2" class="stat-slam clip hidden" data-start="16" data-duration="4.5" data-track-index="3">
        <div data-hf-id="hf-ymdc" class="stat-num" style="color: var(--accent);">38</div>
        <div data-hf-id="hf-ah4q" class="stat-lbl">Automated Tests</div>
      </div>
      <div data-hf-id="hf-3z8n" id="st3" class="stat-slam clip hidden" data-start="16" data-duration="4.5" data-track-index="3">
        <div data-hf-id="hf-jo2j" class="stat-num" style="color: var(--pink);">0 Lost</div>
        <div data-hf-id="hf-bpag" class="stat-lbl">Events Dropped</div>
      </div>

      <!-- ═══ BEAT 5: Tech stack tower (20–26s) ═══ -->
      <div data-hf-id="hf-udgk" id="sr1" class="stack-row clip hidden" data-start="20" data-duration="6.5" data-track-index="4">
        <span data-hf-id="hf-19hh" class="stack-tag" style="border-color: var(--accent); color: var(--accent);">Node.js 20 LTS</span>
        <span data-hf-id="hf-3pz4" class="stack-tag" style="border-color: var(--accent); color: var(--accent);">TypeScript 5.8 strict</span>
      </div>
      <div data-hf-id="hf-31cf" id="sr2" class="stack-row clip hidden" data-start="20" data-duration="6.5" data-track-index="4">
        <span data-hf-id="hf-jxqs" class="stack-tag" style="border-color: #818cf8; color: #c4b5fd;">Fastify 5.2</span>
        <span data-hf-id="hf-dj2o" class="stack-tag" style="border-color: #818cf8; color: #c4b5fd;">Zod 3.24 Validation</span>
        <span data-hf-id="hf-6h7a" class="stack-tag" style="border-color: #818cf8; color: #c4b5fd;">@fastify/rate-limit</span>
      </div>
      <div data-hf-id="hf-z38e" id="sr3" class="stack-row clip hidden" data-start="20" data-duration="6.5" data-track-index="4">
        <span data-hf-id="hf-5brv" class="stack-tag" style="border-color: var(--green); color: var(--green);">PostgreSQL 16 (Neon)</span>
        <span data-hf-id="hf-wu5s" class="stack-tag" style="border-color: var(--green); color: var(--green);">FOR UPDATE SKIP LOCKED</span>
      </div>
      <div data-hf-id="hf-9yq1" id="sr4" class="stack-row clip hidden" data-start="20" data-duration="6.5" data-track-index="4">
        <span data-hf-id="hf-axnx" class="stack-tag" style="border-color: var(--red); color: var(--red);">Redis 7 + ioredis</span>
        <span data-hf-id="hf-k4xm" class="stack-tag" style="border-color: var(--red); color: var(--red);">Atomic Lua EVAL</span>
        <span data-hf-id="hf-ilxx" class="stack-tag" style="border-color: var(--red); color: var(--red);">Pub/Sub Event Bus</span>
      </div>
      <div data-hf-id="hf-6zgg" id="sr5" class="stack-row clip hidden" data-start="20" data-duration="6.5" data-track-index="4">
        <span data-hf-id="hf-5r5n" class="stack-tag" style="border-color: var(--amber); color: var(--amber);">Prometheus /metrics</span>
        <span data-hf-id="hf-gk5a" class="stack-tag" style="border-color: var(--amber); color: var(--amber);">SSE Real-time Stream</span>
        <span data-hf-id="hf-9kp9" class="stack-tag" style="border-color: var(--amber); color: var(--amber);">Pino Structured Logs</span>
      </div>
      <div data-hf-id="hf-huy3" id="sr6" class="stack-row clip hidden" data-start="20" data-duration="6.5" data-track-index="4">
        <span data-hf-id="hf-iuv3" class="stack-tag" style="border-color: var(--pink); color: var(--pink);">Docker Multi-stage</span>
        <span data-hf-id="hf-nttx" class="stack-tag" style="border-color: var(--pink); color: var(--pink);">Docker Compose (PG + Redis)</span>
        <span data-hf-id="hf-vu48" class="stack-tag" style="border-color: var(--pink); color: var(--pink);">Render Deploy</span>
      </div>
      <div data-hf-id="hf-dwu2" id="sr7" class="stack-row clip hidden" data-start="20" data-duration="6.5" data-track-index="4">
        <span data-hf-id="hf-q9hy" class="stack-tag" style="border-color: #94a3b8; color: #94a3b8;">Vitest 3.2 (38 Tests)</span>
        <span data-hf-id="hf-nbtb" class="stack-tag" style="border-color: #94a3b8; color: #94a3b8;">HMAC SHA-256 Signing</span>
        <span data-hf-id="hf-ebma" class="stack-tag" style="border-color: #94a3b8; color: #94a3b8;">SSRF Guard</span>
      </div>

      <!-- ═══ BEAT 6: End card (26–30s) ═══ -->
      <div data-hf-id="hf-x7jq" id="endcard" class="clip hidden" data-start="26" data-duration="4" data-track-index="5">
        <div data-hf-id="hf-u4gq" id="end-title">Distributed Webhook Dispatcher Engine</div>
        <div data-hf-id="hf-menr" id="end-tagline">Built forReady for production.</div>
        <div data-hf-id="hf-acqw" id="end-url">webhookdispatcher.onrender.com</div>
      </div>

      <!-- Audio -->
      <audio data-hf-id="hf-9grb" id="bgm" src="assets/audio/fast_beat.m4a" data-start="0" data-duration="30" preload="auto"></audio>
    </div>

    <script>
      const tl = gsap.timeline({ paused: true });

      /* ═══ BEAT 1: Hero title slam (0–3s) ═══ */
      // Title slams in from blur, word by word feel
      tl.fromTo("#k1", { opacity: 0, scale: 1.3, filter: "blur(16px)" },
        { opacity: 1, scale: 1, filter: "blur(0px)", duration: 0.5, ease: "expo.out" }, 0.1);
      tl.fromTo("#k2", { opacity: 0, y: 30, filter: "blur(8px)" },
        { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.4, ease: "power4.out" }, 0.5);
      // Hold, then exit with blur
      tl.to("#k1", { opacity: 0, scale: 0.9, filter: "blur(12px)", duration: 0.25, ease: "power3.in" }, 2.8);
      tl.to("#k2", { opacity: 0, filter: "blur(8px)", duration: 0.2, ease: "power3.in" }, 2.7);

      /* ═══ BEAT 2: Feature words blast in staggered (3–8s) ═══ */
      const feats = ["#fw1", "#fw2", "#fw3", "#fw4", "#fw5", "#fw6"];
      feats.forEach((id, i) => {
        const fromX = (i % 2 === 0) ? -400 : 400;
        tl.fromTo(id, { opacity: 0, x: fromX, filter: "blur(10px)" },
          { opacity: 1, x: 0, filter: "blur(0px)", duration: 0.35, ease: "expo.out" }, 3.2 + i * 0.4);
      });
      // All exit together with a fast wipe
      feats.forEach((id, i) => {
        tl.to(id, { opacity: 0, x: i % 2 === 0 ? -300 : 300,
          filter: "blur(8px)", duration: 0.2, ease: "power3.in" }, 7.6 + i * 0.03);
      });

      /* ═══ BEAT 3: Architecture assembles top-down (8–16s) ═══ */
      tl.fromTo("#arch-stage", { opacity: 0 }, { opacity: 1, duration: 0.1 }, 8.0);
      // Each node drops in
      const nodes = [
        { id: "#an-client",  t: 8.2, arrow: "#aa1", at: 8.6 },
        { id: "#an-fastify", t: 9.0, arrow: "#aa2", at: 9.4 },
        { id: "#an-pg",      t: 10.0, arrow: "#aa3", at: 10.4 },
        { id: "#an-worker",  t: 11.0, arrow: "#aa4", at: 11.4 },
        { id: "#an-dest",    t: 12.0 },
      ];
      nodes.forEach(n => {
        tl.fromTo(n.id, { opacity: 0, y: -40, filter: "blur(6px)" },
          { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.4, ease: "power4.out" }, n.t);
        if (n.arrow) {
          tl.fromTo(n.arrow, { scaleY: 0, opacity: 0 },
            { scaleY: 1, opacity: 1, duration: 0.3, ease: "power2.out" }, n.at);
        }
      });
      // Camera zoom into worker node
      tl.to("#arch-stage", { scale: 1.15, y: -60, duration: 1.5, ease: "power2.inOut" }, 13.0);
      // Exit
      tl.to("#arch-stage", { opacity: 0, scale: 0.85, filter: "blur(10px)",
        duration: 0.3, ease: "power3.in" }, 15.5);

      /* ═══ BEAT 4: Stats slam in with scale punch (16–20s) ═══ */
      const stats = ["#st1", "#st2", "#st3"];
      stats.forEach((id, i) => {
        tl.fromTo(id, { opacity: 0, scale: 2.5, filter: "blur(12px)" },
          { opacity: 1, scale: 1, filter: "blur(0px)", duration: 0.4, ease: "expo.out" }, 16.3 + i * 0.6);
      });
      // Hold, then exit
      stats.forEach((id, i) => {
        tl.to(id, { opacity: 0, y: -50, filter: "blur(6px)",
          duration: 0.2, ease: "power3.in" }, 19.5 + i * 0.04);
      });

      /* ═══ BEAT 5: Tech stack tower builds (20–26s) ═══ */
      const rows = ["#sr1", "#sr2", "#sr3", "#sr4", "#sr5", "#sr6", "#sr7"];
      rows.forEach((id, i) => {
        tl.fromTo(id, { opacity: 0, y: 50, filter: "blur(6px)" },
          { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.35, ease: "power4.out" }, 20.2 + i * 0.45);
      });
      // Hold the tower, then exit all
      rows.forEach((id, i) => {
        tl.to(id, { opacity: 0, scale: 0.95, filter: "blur(4px)",
          duration: 0.15, ease: "power3.in" }, 25.6 + i * 0.02);
      });

      /* ═══ BEAT 6: End card (26–30s) ═══ */
      tl.fromTo("#end-title", { opacity: 0, scale: 1.2, filter: "blur(12px)" },
        { opacity: 1, scale: 1, filter: "blur(0px)", duration: 0.5, ease: "expo.out" }, 26.2);
      tl.fromTo("#end-tagline", { opacity: 0, y: 20, filter: "blur(6px)" },
        { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.4, ease: "power4.out" }, 26.7);
      tl.fromTo("#end-url", { opacity: 0, y: 15 },
        { opacity: 1, y: 0, duration: 0.35, ease: "power4.out" }, 27.1);
      tl.fromTo("#endcard", { opacity: 0 }, { opacity: 1, duration: 0.1 }, 26.1);

      window.__timelines["main"] = tl;
      tl.seek(0);
    </script>
  </body>
</html>
